{
  "name": "@paskod121/relais",
  "version": "0.1.1",
  "description": "Checks npm packages before you, or your AI coding agent, install them: invented names, fresh releases, known malware, lookalikes. Zero dependencies, no telemetry.",
  "keywords": [
    "npm",
    "security",
    "supply-chain",
    "ai-agents",
    "slopsquatting",
    "typosquatting",
    "malware",
    "package-manager",
    "cli",
    "offline"
  ],
  "homepage": "https://github.com/Paskod121/relais#readme",
  "bugs": {
    "url": "https://github.com/Paskod121/relais/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paskod121/relais.git"
  },
  "license": "MIT",
  "author": "Pascal Sewonou (Paskod)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "relais": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:live": "node --test \"test-live/**/*.test.ts\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^22.18.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
